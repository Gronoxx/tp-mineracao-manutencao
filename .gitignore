# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ambientes Virtuais (Virtual Environments)
venv/
.venv/
env/
.env/
ENV/
# Dados minerados (reproduziveis — nao versionar; ver tp-es2-dataset).
# Usamos `data/**` (não `data/`) para permitir re-inclusão de subdiretórios:
# o git não re-inclui arquivos cujo diretório-pai foi ignorado.
data/**
# Exceção: catálogos de oracles (held-out test) SÃO versionados — são pequenos
# (~600 entradas, sem código) e precisam ser reprodutíveis com o repo.
!data/test/
!data/test/**

# Logs de execução das minerações (reproduzíveis, grandes — não versionar).
# Exceção: o log de issues da sessão É documentação e SÃO versionados.
logs/*.log
!logs/auto_session_issues.md

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
